{
  "name": "serenibase-sdk",
  "version": "1.0.0",
  "description": "Official JavaScript SDK for SereniBase APIs",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --testPathPattern=tests/integration",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "type-check": "tsc --noEmit",
    "docs": "typedoc src/index.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "keywords": [
    "serenibase",
    "sdk",
    "typescript",
    "database",
    "rest-api",
    "api-client"
  ],
  "author": "Aptlogica Technologies",
  "repository": {
    "type": "git",
    "url": "https://github.com/aptlogica/base-sdk.git"
  },
  "homepage": "https://github.com/aptlogica/base-sdk#readme",
  "bugs": {
    "url": "https://github.com/aptlogica/base-sdk/issues"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "axios": "^1.14.0",
    "eventemitter3": "^5.0.1",
    "formdata-node": "^6.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.2.5",
    "rollup": "^4.21.2",
    "ts-jest": "^29.2.5",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "overrides": {
    "serialize-javascript": "^7.1.2",
    "minimatch": "^9.0.5",
    "rollup": "^4.21.2",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.1.0"
    },
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "type-detect": "^4.1.0",
    "undici-types": "^8.12.1",
    "@types/resolve": "^1.20.6",
    "mime-db": "^1.54.0",
    "pretty-format": "30.3.0",
    "glob": "^12.0.0"
  }
}
